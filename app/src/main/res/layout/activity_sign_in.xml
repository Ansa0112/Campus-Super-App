<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E295B"
    tools:context=".SignInActivity">

    <!-- Header Section with Curved Bottom and App Logo Icon -->
    <RelativeLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curve"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Larger Yellow Background Badge with Enlarged Book Icon -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_yellow_rounded_box"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_book_icon"
            android:contentDescription="Book Logo"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivLogo"
            android:text="Welcome back"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_marginTop="4dp"
            android:text="Sign in to Campus Super App"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- White Card Body Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerArea"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- University Email Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="University email"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="name@fui.edu.pk"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="16dp"/>

                <!-- Password Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter your password"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="textPassword"
                    android:layout_marginBottom="12dp"/>

                <!-- Remember me & Forgot Password Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/cbRemember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remember me"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:buttonTint="#1E295B"
                        android:layout_centerVertical="true"/>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Forgot password?"
                        android:textColor="#1E295B"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <!-- Primary Sign in Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sign in"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:backgroundTint="#1E295B"
                    app:cornerRadius="26dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Divider Text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="or"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"/>

                <!-- Secondary Help / Contact us Outline Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNeedHelp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Need help? Contact us"
                    android:textColor="#1E295B"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_menu_help"
                    app:iconTint="#1E295B"
                    app:iconGravity="text_start"
                    android:layout_marginBottom="32dp"/>

                <!-- New here? Create an account Link -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New here? "
                        android:textColor="#64748B"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvCreateAccountLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create an account"
                        android:textColor="#1E295B"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>