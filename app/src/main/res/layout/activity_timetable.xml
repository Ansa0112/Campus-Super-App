<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timetableRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/timetableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E295B"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp">

        <RelativeLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/ivBack"
                android:text="CAMPUS ACADEMICS"
                android:textColor="#BFDBFE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Class Timetables"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Weekly Class &amp; Lab Schedule Matrix"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- View Mode Switcher + Admin Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <!-- Mode Segmented Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_role_bar"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnModeGrid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Grid Table"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_role_selected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnModeList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cards List"
                android:textColor="#475569"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Admin Upload Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadTimetable"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_submit_complaint"
            android:paddingHorizontal="14dp"
            android:text="+ Add Slot"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Calendar / Day Selector Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/containerDayChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Filter Bar (Department Filter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Department:"
            android:textColor="#1E295B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spFilterDepartment"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="10dp"
            android:popupBackground="@drawable/bg_dropdown_popup" />

    </LinearLayout>

    <!-- Active Schedule Day Banner -->
    <TextView
        android:id="@+id/tvActiveDayBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#15803D"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="Monday - Weekly Class &amp; Lab Schedule"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Container for Grid Table Matrix View -->
    <HorizontalScrollView
        android:id="@+id/scrollGridHorizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TableLayout
                android:id="@+id/tableGridMatrix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E2E8F0"
                android:padding="1dp" />

        </ScrollView>
    </HorizontalScrollView>

    <!-- Scrollable Timetable List View (Cards List Mode) -->
    <ScrollView
        android:id="@+id/scrollListContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyTimetable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_complaint_card"
                android:text="No timetable slots found for the selected day and department."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerTimetables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
