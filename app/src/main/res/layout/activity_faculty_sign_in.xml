<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E295B"
    tools:context=".activity_faculty_sign_in">

    <!-- Header Section with Curved Bottom and Glowing Sun Graphic -->
    <RelativeLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curve"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Container for the Soft Blue Glow and Yellow Sun Graphic -->
        <RelativeLayout
            android:id="@+id/sunContainer"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="-28dp">

            <!-- Soft Blue Glowing Aura Shape -->
            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_header_blob" />

            <!-- Yellow Sun Circle overlapping it -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="42dp"
                android:background="@drawable/bg_yellow_circle" />
        </RelativeLayout>

        <!-- Top Faculty Icon Container -->
        <ImageView
            android:id="@+id/ivFacultyIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_admin"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="#FACC15"
            android:contentDescription="Faculty Icon" />

        <!-- Faculty Portal Badge -->
        <TextView
            android:id="@+id/tvFacultyPortalBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivFacultyIcon"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_admin"
            android:text="FACULTY PORTAL"
            android:textColor="#FACC15"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"/>

        <!-- Header Title: Welcome, Faculty (Positioned directly under FACULTY PORTAL) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvFacultyPortalBadge"
            android:layout_toStartOf="@id/sunContainer"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            android:text="Welcome, Faculty"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Header Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_toStartOf="@id/sunContainer"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:text="Sign in to manage announcements and student issues"
            android:textColor="#94A3B8"
            android:textSize="12.5sp" />
    </RelativeLayout>

    <!-- White Body Card Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerArea"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Input Field: Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#94A3B8"
                        android:contentDescription="Email Icon"/>

                    <EditText
                        android:id="@+id/etIdentifier"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Email"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="textEmailAddress"/>
                </LinearLayout>

                <!-- Input Field: Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="#94A3B8"
                        android:contentDescription="Password Icon"/>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Password"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="textPassword"/>
                </LinearLayout>

                <!-- Remember Me & Forgot Password Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#1E295B"
                        android:text="Remember me"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Forgot password?"
                        android:textColor="#1E295B"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Primary Sign In Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignInFaculty"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sign in as Faculty"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:backgroundTint="#1E295B"
                    app:cornerRadius="26dp"
                    android:layout_marginBottom="32dp"/>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>