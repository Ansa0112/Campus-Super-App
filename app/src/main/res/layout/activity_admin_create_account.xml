<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E295B"
    tools:context=".activity_admin_create_account">

    <!-- Header Section with Curved Bottom and Glowing Sun Graphic -->
    <RelativeLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curve"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#FFFFFF" />

        <!-- Container for the Soft Blue Glow and Yellow Sun (Isolated to prevent text overlap) -->
        <RelativeLayout
            android:id="@+id/sunContainer"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="-28dp">

            <!-- Soft Blue Glowing Aura Shape -->
            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_header_blob" />

            <!-- Yellow Sun Circle -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="42dp"
                android:background="@drawable/bg_yellow_circle" />
        </RelativeLayout>

        <!-- Admin Badge -->
        <TextView
            android:id="@+id/tvAdminBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnBack"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_admin"
            android:text="ADMIN"
            android:textColor="#FACC15"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"/>

        <!-- Header Title (Constrained to not overlap sunContainer) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvAdminBadge"
            android:layout_toStartOf="@id/sunContainer"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            android:text="Request access"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- White Body Card Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerArea"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Role Toggle Bar (Student | Faculty | Admin) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btnTabStudent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center"
                        android:text="Student"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTabFaculty"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center"
                        android:text="Faculty"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Admin tab initialized with active blue pill background -->
                    <TextView
                        android:id="@+id/btnTabAdmin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_role_selected"
                        android:gravity="center"
                        android:text="Admin"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Yellow Info Banner Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FEF9C3"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FEF08A">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="#A16207"
                            android:contentDescription="Info Icon"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Admin accounts are reviewed and approved by the university before use."
                            android:textColor="#854D0E"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Input Field: Full name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#94A3B8"
                        android:contentDescription="Name Icon"/>

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Full name"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="textPersonName"/>
                </LinearLayout>

                <!-- Input Field: Admin ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#94A3B8"
                        android:contentDescription="Admin ID Icon"/>

                    <EditText
                        android:id="@+id/etAdminId"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Admin ID"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="text"/>
                </LinearLayout>

                <!-- Input Field: University email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_dialog_email"
                        app:tint="#94A3B8"
                        android:contentDescription="Email Icon"/>

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="University email"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="textEmailAddress"/>
                </LinearLayout>

                <!-- Input Field: Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="#94A3B8"
                        android:contentDescription="Password Icon"/>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Password"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="textPassword"/>
                </LinearLayout>

                <!-- Input Field: Confirm password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="#94A3B8"
                        android:contentDescription="Confirm Password Icon"/>

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Confirm password"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:background="@null"
                        android:layout_marginStart="10dp"
                        android:inputType="textPassword"/>
                </LinearLayout>

                <!-- Checkbox: Terms Agreement -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <CheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#1E295B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I agree to the Terms of Use and Privacy Policy"
                        android:textColor="#475569"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Primary Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitApproval"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Submit for approval"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:backgroundTint="#1E295B"
                    app:cornerRadius="26dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Already approved? Sign in Link -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Already approved? "
                        android:textColor="#64748B"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvSignInLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign in"
                        android:textColor="#1E295B"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>