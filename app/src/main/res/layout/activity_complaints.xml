
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/complaintsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:id="@+id/complaintsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1E295B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUS SUPPORT"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complaints &amp; Issues"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report a problem and track its progress."
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/complaintsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit a Complaint"
                android:textColor="#0F172A"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complaint title *"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etComplaintTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Broken classroom projector"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:minHeight="52dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category *"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spComplaintCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/btn_dropdown"
                android:paddingHorizontal="10dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description *"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etComplaintDescription"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:hint="Explain the issue and where it occurred..."
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnSubmitComplaint"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Submit Complaint"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Complaints"
                android:textColor="#0F172A"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvComplaintsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your submitted complaints will appear here."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:padding="16dp"
                android:gravity="center" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComplaints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
