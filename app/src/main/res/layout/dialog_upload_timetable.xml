<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Timetable Slot"
            android:textColor="#1E295B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Fill in class schedule details"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Subject / Course Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject / Course Name *"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTtSubject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Software Engineering"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- Department -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Department / Program *"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTtDepartment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_dropdown_popup" />

        <!-- Day -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Day of the Week *"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTtDay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_dropdown_popup" />

        <!-- Room / Venue Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room / Venue *"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTtRoom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_dropdown_popup" />

        <!-- Time Slot Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time Slot *"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTtTimeSlot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_dropdown_popup" />

        <!-- Instructor Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructor Name"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTtInstructor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Dr. Ahmed Khan"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveTtEntry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_submit_complaint"
            android:text="Upload Timetable Slot"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
